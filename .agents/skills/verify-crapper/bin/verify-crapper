#!/usr/bin/env bash
# Check and drive this checkout's crapper against a scratch project. Run from anywhere.
set -euo pipefail

repo=$(cd "$(dirname "$0")/../../../.." && pwd)
crapper="$repo/crapper"
scratch_prefix="$(realpath -m -- "${TMPDIR:-/tmp}")/crapper-verify."

# Prints the scratch folder that holds path $1 after resolving `..` and symlinks, or fails.
scratch_root() {
  local path rest
  path=$(realpath -m -- "$1")
  rest=${path#"$scratch_prefix"}
  [[ $rest != "$path" && -n $rest ]] || return 1
  echo "$scratch_prefix${rest%%/*}"
}

usage() {
  cat <<USAGE
usage: verify-crapper doctor
       verify-crapper project typescript | typescript-failing | rust | rust-split | rust-untested | rust-workspace | rust-siblings | rust-test-fns | rust-test-macros | rust-test-modules | python-flat | python-mixed | languages | <git repo>
       verify-crapper stale <project> <report path> <source path>
       verify-crapper drive [--path <PATH>] <project> <transcript> [crapper args...]
       verify-crapper exec <project> <transcript> <command> [args...]
       verify-crapper cleanup <project>
USAGE
  exit 2
}

checkout() {
  echo "$(git -C "$repo" rev-parse --short HEAD) on $(git -C "$repo" branch --show-current)$([[ -z "$(git -C "$repo" status --porcelain -- src crapper pyproject.toml)" ]] || echo ' + uncommitted changes')"
}

commit_fixture() {
  local project=$1
  printf 'target/\n.metrics/\ncoverage/\nnode_modules/\n.venv/\n' >"$project/.gitignore"
  git -C "$project" init -q
  git -C "$project" add -A
  git -C "$project" -c user.name=verify -c user.email=verify@localhost commit -qm fixture
}

# A TypeScript package with one function, `tick`, on line 1 of src/clock.ts.
# Its `coverage` script is `sh coverage.sh`, which needs no npm install.
# typescript: coverage.sh writes coverage/lcov.info with line 1 hit (100%).
# typescript-failing: coverage.sh exits 1 and writes nothing.
write_typescript() {
  local project=$1 failing=$2
  mkdir -p "$project/src"
  printf '{"name":"clock","private":true,"scripts":{"coverage":"sh coverage.sh"}}\n' >"$project/package.json"
  printf 'export function tick(): number { return 1 }\n' >"$project/src/clock.ts"
  if [[ $failing == yes ]]; then
    printf 'echo "coverage.sh: tests failed" >&2\nexit 1\n' >"$project/coverage.sh"
  else
    printf 'mkdir -p coverage\nprintf "SF:src/clock.ts\\nDA:1,1\\nLF:1\\nLH:1\\nend_of_record\\n" > coverage/lcov.info\n' >"$project/coverage.sh"
  fi
  commit_fixture "$project"
}

# A Cargo package in folder $1, named $2, with src/lib.rs $3. Its integration
# test (tests/$2.rs, which crapper skips) calls `$2::$4`. $5, when given, is
# appended to Cargo.toml (a [workspace] table, or [features]).
write_crate() {
  local dir=$1 name=$2 lib=$3 called=$4 extra=${5:-}
  mkdir -p "$dir/src" "$dir/tests"
  printf '[package]\nname = "%s"\nversion = "0.1.0"\nedition = "2021"\n%s' "$name" "$extra" >"$dir/Cargo.toml"
  printf '%s' "$lib" >"$dir/src/lib.rs"
  printf '#[test]\nfn calls() {\n    %s::%s();\n}\n' "$name" "$called" >"$dir/tests/$name.rs"
}

# A Cargo package named clock with the given src/lib.rs, whose integration test calls `tick`.
write_cargo_package() {
  write_crate "$1" clock "$2" tick
  commit_fixture "$1"
}

# rust-workspace: a workspace whose root is the package clock (tick tested,
#   tock not), with a member crate gears/ (spin tested, idle not). Both have
#   src/lib.rs, and cargo-llvm-cov names both by absolute path.
# rust-siblings: a virtual workspace with sibling members clock/ and gears/,
#   the same two crates.
write_workspace() {
  local project=$1 kind=$2
  if [[ $kind == root ]]; then
    write_crate "$project" clock "$rust_lib_untested" tick $'\n[workspace]\nmembers = ["gears"]\n'
  else
    mkdir -p "$project"
    printf '[workspace]\nmembers = ["clock", "gears"]\nresolver = "2"\n' >"$project/Cargo.toml"
    write_crate "$project/clock" clock "$rust_lib_untested" tick
  fi
  write_crate "$project/gears" gears "$rust_lib_gears" spin
  commit_fixture "$project"
}

# rust-test-modules: crapper skips the functions in checks.rs, checks/deeper.rs,
# fixtures/mod.rs, outer/inner.rs, inline/leaf.rs, support/helpers.rs
# (#[path]), gated.rs, tests.rs (a bare `mod tests;`), and cli_checks.rs
# (declared in main.rs). It scores tick, main, outer_fn, util_fn, real_fn,
# shared_fn (lib.rs declares it test-only, main.rs plainly), and orphan_fn
# (declared nowhere). It compiles, so a default run measures coverage.
write_modules() {
  local project=$1 file
  write_crate "$project" tree 'pub fn tick() -> i32 {
    1
}

pub mod outer;
mod util;

#[cfg(test)]
mod checks;

#[cfg(test)]
mod fixtures;

#[cfg(test)]
mod inline {
    mod leaf;
}

#[cfg(test)]
#[path = "support/helpers.rs"]
mod helpers;

#[cfg(all(test, feature = "x"))]
mod gated;

mod tests;

#[cfg(not(test))]
mod real;

#[cfg(test)]
mod shared;
' tick $'\n[features]\nx = []\n'
  printf '%s' 'fn main() {
    println!("{}", tree::tick());
}

mod shared;

#[cfg(test)]
mod cli_checks;
' >"$project/src/main.rs"
  printf '%s' 'mod deeper;

fn checks_sample() -> i32 {
    super::tick()
}

#[test]
fn checks_test() {
    assert_eq!(checks_sample(), 1);
}
' >"$project/src/checks.rs"
  printf '%s' 'pub fn outer_fn() -> i32 {
    4
}

#[cfg(test)]
mod inner;
' >"$project/src/outer.rs"
  for file in checks/deeper:deeper_probe fixtures/mod:fixtures_probe outer/inner:inner_probe \
    inline/leaf:leaf_probe support/helpers:helpers_probe gated:gated_probe tests:tests_probe \
    cli_checks:cli_probe util:util_fn real:real_fn shared:shared_fn orphan:orphan_fn; do
    mkdir -p "$(dirname "$project/src/${file%%:*}.rs")"
    printf 'pub fn %s() -> i32 {\n    2\n}\n' "${file#*:}" >"$project/src/${file%%:*}.rs"
  done
  commit_fixture "$project"
}

# rust: one function, `tick`, on line 1 of src/lib.rs, so it is the only scored function.
# rust-split: `tick` and `tock`. Only a unit test (in src/lib.rs's `mod tests`,
#   which crapper skips) calls `tock`, so `cargo llvm-cov --lib` and
#   `cargo llvm-cov --test clock` each cover one of them.
# rust-untested: `tick` and `tock`, and nothing calls `tock`.
# rust-test-fns: `tick` and `tock`, test code crapper skips (top-level and
#   stacked #[test], #[cfg(test)] on a function, a mod, and an impl, and
#   #[cfg(all(test, feature = "x"))]), and non-test controls it scores.
# rust-test-macros: test attributes from crates the fixture doesn't have
#   (#[tokio::test], #[rstest], #[test_case], #[test_matrix], #[proptest],
#   #[property_test], #[wasm_bindgen_test], #[quickcheck], and path forms), a
#   function in a proptest! body, and controls (#[testing::helper],
#   #[wasm_bindgen], #[test_cases], #[quickcheck_helper]). It doesn't compile,
#   so drive it with --no-coverage.
# rust-test-modules: the package tree, with src/lib.rs and src/main.rs, whose
#   test-only modules are declared with `mod x;` and kept in their own files
#   (write_modules lists them), and production modules crapper still scores.
rust_lib_rust='pub fn tick() -> i32 { 1 }
'
rust_lib_untested='pub fn tick() -> i32 {
    1
}

pub fn tock() -> i32 {
    2
}
'
rust_lib_gears='pub fn idle() -> i32 {
    0
}

pub fn spin() -> i32 {
    3
}
'
rust_lib_test_fns="${rust_lib_untested}
#[test]
fn ticks() {
    assert_eq!(tick(), 1);
}

#[should_panic]
#[test]
fn panics() {
    if tick() == 1 {
        panic!(\"one\");
    }
}

#[cfg(test)]
fn helper() -> i32 {
    tick()
}

#[cfg(test)]
mod checks {
    fn probe() -> i32 {
        super::tick()
    }
}

pub struct Dial;

#[cfg(test)]
impl Dial {
    fn turn(&self) -> i32 {
        tick()
    }
}

#[cfg(all(test, feature = \"x\"))]
fn gated() -> i32 {
    tick()
}

#[must_use]
pub fn kept() -> i32 {
    5
}

#[cfg(not(test))]
pub fn real() -> i32 {
    2
}

#[cfg(any(test, feature = \"x\"))]
pub fn either() -> i32 {
    3
}
"
rust_lib_test_macros="${rust_lib_untested}
#[tokio::test]
async fn served() {
    assert_eq!(tick(), 1);
}

#[rstest]
fn cases() {
    assert_eq!(tick(), 1);
}

#[testing::helper]
pub fn assisted() -> i32 {
    4
}

#[test_case(1)]
fn cased(n: i32) {
    assert_eq!(tick(), n);
}

#[test_case::test_case(2)]
fn cased_path(n: i32) {
    assert_eq!(tick() + 1, n);
}

#[test_matrix([1, 2])]
fn matrixed(n: i32) {
    assert!(tick() <= n);
}

#[proptest]
fn proped(n: u8) {
    assert!(tick() <= i32::from(n) + 1);
}

#[property_test]
fn property(n: u8) {
    assert!(tick() <= i32::from(n) + 1);
}

#[wasm_bindgen_test]
fn in_browser() {
    assert_eq!(tick(), 1);
}

#[wasm_bindgen_test::wasm_bindgen_test]
fn in_browser_path() {
    assert_eq!(tick(), 1);
}

#[quickcheck]
fn checked(n: u8) -> bool {
    tick() <= i32::from(n) + 1
}

#[quickcheck_macros::quickcheck]
fn checked_path(n: u8) -> bool {
    tick() <= i32::from(n) + 1
}

proptest! {
    #[test]
    fn in_proptest_body(n in 0..10u8) {
        assert!(tick() <= i32::from(n) + 1);
    }
}

#[wasm_bindgen]
pub fn greet() -> i32 {
    tick()
}

#[test_cases]
pub fn plural() -> i32 {
    6
}

#[quickcheck_helper]
pub fn aided() -> i32 {
    7
}
"
rust_lib_split="${rust_lib_untested}
#[cfg(test)]
mod tests {
    #[test]
    fn tocks() {
        assert_eq!(super::tock(), 2);
    }
}
"

# A Python project with demo.py at its root (verify-mutator's fixture shape): a
# test at the root calls `tick`, nothing calls `tock`, and nothing imports
# extra.py (`unused`). Its .venv sees python3's coverage and pytest.
# python-mixed adds the package gears/, whose `spin` a root test calls.
write_python() {
  local project=$1 mixed=$2
  mkdir -p "$project"
  printf '[tool.pytest.ini_options]\ntestpaths = ["."]\n' >"$project/pyproject.toml"
  printf 'def tick():\n    return 1\n\n\ndef tock():\n    return 2\n' >"$project/demo.py"
  printf 'def unused():\n    return 3\n' >"$project/extra.py"
  printf 'from demo import tick\n\n\ndef test_tick():\n    assert tick() == 1\n' >"$project/test_demo.py"
  if [[ $mixed == yes ]]; then
    mkdir -p "$project/gears"
    : >"$project/gears/__init__.py"
    printf 'def spin():\n    return 3\n' >"$project/gears/spin.py"
    printf 'from gears.spin import spin\n\n\ndef test_spin():\n    assert spin() == 3\n' >"$project/test_gears.py"
  fi
  python3 -m venv --system-site-packages "$project/.venv"
  commit_fixture "$project"
}

# languages: one function in each tree-sitter language (Python, Rust, Go,
# TypeScript, Java), so a run parses each grammar crapper takes from the language pack.
write_languages() {
  local project=$1
  mkdir -p "$project"
  printf 'def a(x):\n    return f(x) + 1\n' >"$project/p.py"
  printf 'fn a(x: i32) -> i32 { f(x) + 1 }\n' >"$project/r.rs"
  printf 'package p\nfunc A(x int) int { return f(x) + 1 }\n' >"$project/g.go"
  printf 'function a(x) { return f(x) + 1; }\n' >"$project/t.ts"
  printf 'class J {\n  int a(int x) { return f(x) + 1; }\n}\n' >"$project/J.java"
  commit_fixture "$project"
}

# Lists the coverage reports crapper can read, with their modification times.
reports() {
  local project=$1
  (cd "$project" && find . \( -path ./node_modules -o -path ./.git \) -prune -o -type f \
    \( -name lcov.info -o -name coverage.out -o -name jacoco.xml \) -printf '%p  %TF %TT\n' | sort)
}

# Prints each .metrics/crap.edn in the project at $1, so a run from a subfolder, or with
# --root naming a subfolder, still shows its snapshot. The one at the top prints
# alone; any other is headed by its path.
snapshots() {
  local top=$1 found=no file
  while IFS= read -r file; do
    found=yes
    [[ $file == ./.metrics/crap.edn ]] || echo "($file)"
    cat "$top/$file"
  done < <(cd "$top" && find . \( -path ./node_modules -o -path ./.git \) -prune -o -path '*/.metrics/crap.edn' -print | sort)
  [[ $found == yes ]] || echo "(none)"
}

# Runs "$@" in the project folder and appends the action, what the user saw, and
# the state left behind. Reports and snapshots are listed from the project's top
# folder, wherever in it the command ran.
record() {
  local project=$1 transcript=$2 shown=$3 path=$4
  shift 4
  mkdir -p "$(dirname "$transcript")"
  local out err code before top
  out=$(mktemp) err=$(mktemp)
  top=$(git -C "$project" rev-parse --show-toplevel)
  before=$(reports "$top")
  set +e
  (cd "$project" && PATH="$path" "$@") >"$out" 2>"$err"
  code=$?
  set -e
  {
    echo "\$ (cd $project) $shown"
    [[ $path == "$PATH" ]] || echo "PATH: $path"
    echo "date: $(date '+%F %T %Z')"
    echo "crapper: $(checkout)"
    echo "exit code: $code"
    echo "--- coverage reports before"; grep . <<<"$before" || echo "(none)"
    echo "--- stdout"; cat "$out"
    echo "--- stderr"; cat "$err"
    echo "--- coverage reports after"; reports "$top" | grep . || echo "(none)"
    echo "--- .metrics/crap.edn"; snapshots "$top"
    echo "--- tracked files changed (git status --short)"
    git -C "$project" status --short --untracked-files=no | grep . || echo "(none)"
    echo
  } | tee -a "$transcript"
  rm -f "$out" "$err"
}

# Prints each argument shell-quoted with a leading space, or nothing when there are none.
quoted() {
  [[ $# -eq 0 ]] || printf ' %q' "$@"
}

require_scratch() {
  scratch_root "$2" >/dev/null || { echo "$1: refusing $2; it is not inside a verify-crapper scratch folder"; exit 1; }
}

case "${1:-}" in
  doctor)
    [[ -x "$crapper" ]] || { echo "doctor: no launcher at $crapper"; exit 1; }
    "$crapper" --help >/dev/null 2>&1 || { echo "doctor: $crapper --help failed; run it once to build .venv"; exit 1; }
    imported=$("$repo/.venv/bin/python" -c 'import crapper; print(crapper.__file__)')
    [[ $imported == "$repo/src/crapper/__init__.py" ]] || { echo "doctor: .venv imports $imported, not this checkout's src"; exit 1; }
    echo "doctor: ok"
    echo "crapper:  $crapper ($("$repo/.venv/bin/python" --version))"
    echo "imports:  $imported"
    echo "checkout: $(checkout)"
    echo "tools:    npm $(command -v npm >/dev/null && npm --version || echo missing), cargo-llvm-cov $(command -v cargo-llvm-cov >/dev/null && echo found || echo missing)"
    # A Rust drive runs cargo in a scratch project, where a mise shim finds no toolchain.
    probe=$(mktemp -d "${scratch_prefix}XXXXXX")
    if (cd "$probe" && cargo llvm-cov --version) >/dev/null 2>&1; then
      echo "rust:     cargo llvm-cov runs in a scratch project"
    else
      echo "rust:     cargo llvm-cov fails in a scratch project; with mise, export MISE_RUST_VERSION=<version> before a Rust drive"
    fi
    rm -rf -- "$probe"
    ;;
  project)
    [[ $# -eq 2 ]] || usage
    scratch=$(mktemp -d "${scratch_prefix}XXXXXX")
    case $2 in
      typescript) write_typescript "$scratch/project" no ;;
      typescript-failing) write_typescript "$scratch/project" yes ;;
      rust) write_cargo_package "$scratch/project" "$rust_lib_rust" ;;
      rust-split) write_cargo_package "$scratch/project" "$rust_lib_split" ;;
      rust-untested) write_cargo_package "$scratch/project" "$rust_lib_untested" ;;
      rust-workspace) write_workspace "$scratch/project" root ;;
      rust-siblings) write_workspace "$scratch/project" virtual ;;
      rust-test-fns)
        write_crate "$scratch/project" clock "$rust_lib_test_fns" tick $'\n[features]\nx = []\n'
        commit_fixture "$scratch/project" ;;
      rust-test-macros) write_cargo_package "$scratch/project" "$rust_lib_test_macros" ;;
      rust-test-modules) write_modules "$scratch/project" ;;
      python-flat) write_python "$scratch/project" no ;;
      python-mixed) write_python "$scratch/project" yes ;;
      languages) write_languages "$scratch/project" ;;
      *) git clone -q -- "$2" "$scratch/project" ;;
    esac
    echo "$scratch/project"
    ;;
  stale)
    # An earlier run's report: every line of the source file hit once.
    [[ $# -eq 4 ]] || usage
    project=$2 report=$3 source=$4
    require_scratch stale "$project"
    lines=$(wc -l <"$project/$source")
    mkdir -p "$(dirname "$project/$report")"
    {
      echo "SF:$source"
      for ((line = 1; line <= lines; line++)); do echo "DA:$line,1"; done
      echo "LF:$lines"
      echo "LH:$lines"
      echo "end_of_record"
    } >"$project/$report"
    touch -d '2 days ago' "$project/$report"
    echo "wrote $report: $lines of $lines lines of $source covered, dated 2 days ago"
    ;;
  drive)
    shift
    path=$PATH
    if [[ ${1:-} == --path ]]; then
      [[ $# -ge 2 ]] || usage
      path=$2
      shift 2
    fi
    [[ $# -ge 2 ]] || usage
    project=$1 transcript=$2
    shift 2
    require_scratch drive "$project"
    record "$project" "$transcript" "crapper$(quoted "$@")" "$path" "$crapper" "$@"
    ;;
  exec)
    [[ $# -ge 4 ]] || usage
    project=$2 transcript=$3
    shift 3
    require_scratch exec "$project"
    record "$project" "$transcript" "$(quoted "$@" | cut -c2-)" "$PATH" "$@"
    ;;
  cleanup)
    [[ $# -eq 2 ]] || usage
    root=$(scratch_root "$2") || { echo "cleanup: refusing to remove $2; it is not a verify-crapper scratch folder"; exit 1; }
    path=$(realpath -m -- "$2")
    [[ $path == "$root" || $path == "$root/project" ]] || { echo "cleanup: refusing to remove $2; pass the project or its scratch folder"; exit 1; }
    rm -rf -- "$root"
    echo "removed $root"
    ;;
  *) usage ;;
esac
